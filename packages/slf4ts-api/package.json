{
  "name": "slf4ts-api",
  "description": "Simple logging facade for nodejs",
  "homepage": "https://github.com/rstiller/slf4ts",
  "version": "1.4.0",
  "main": "./build/packages/slf4ts-api/lib/slf4ts/index.js",
  "typings": "./build/packages/slf4ts-api/lib/slf4ts/index.d.ts",
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://www.opensource.org/licenses/mit-license.php"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rstiller/slf4ts"
  },
  "keywords": [
    "typescript",
    "logging"
  ],
  "engines": {
    "node": ">= 20",
    "npm": ">= 10"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "npm run clean && npm run lint && npm run compile",
    "clean": "rimraf build",
    "compile": "tsc -p .",
    "lint": "biome check .",
    "prepublishOnly": "npm run build",
    "test": "mocha test/**/*Test.mts"
  },
  "mocha": {
    "node-option": [
      "import=tsx"
    ],
    "reporter": "dot",
    "extension": "mts",
    "full-trace": true
  }
}
