{
  "name": "slf4ts",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@testdeck/mocha": "0.3.3",
    "@types/chai": "^5.2.3",
    "@types/lodash": "^4.14.195",
    "@types/mocha": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/sinon": "^22.0.0",
    "chai": "^6.2.2",
    "lodash": "^4.17.21",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "serialize-javascript": "^7.1.1",
    "sinon": "^22.1.0",
    "testdouble": "^3.18.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "example": "pnpm run --recursive --if-present start",
    "build": "pnpm run --recursive build",
    "clean": "pnpm run --recursive clean && rimraf coverage docs",
    "compile": "pnpm run --recursive compile",
    "coverage": "nyc pnpm run --recursive test",
    "deps": "pnpm outdated -r",
    "lint": "pnpm run --recursive lint",
    "pretest": "pnpm run --recursive --filter slf4ts-api compile",
    "publishDocs": "cd docs && git add --all . && git commit -nm 'Deploy to gh-pages' && git push origin gh-pages && cd ..",
    "prepublishDocs": "docker-compose run --rm docs",
    "test": "pnpm run --recursive test"
  },
  "compodoc": {
    "tsconfig": "./tsconfig.docs.json",
    "output": "./docs",
    "disableGraph": true,
    "includes": "./",
    "includeNames": "READMEs",
    "unitTestCoverage": "./coverage/coverage-summary.json"
  },
  "nyc": {
    "include": [
      "packages/*/lib/*.ts",
      "packages/*/lib/**/*.ts"
    ],
    "exclude": [
      "packages/*/test/*"
    ],
    "extension": [
      ".ts"
    ],
    "require": [],
    "reporter": [
      "json-summary"
    ],
    "all": true
  }
}
